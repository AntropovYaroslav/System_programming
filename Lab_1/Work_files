#!/bin/bash
# Лабораторная работа 1. Работа с файлами
# Антропов Ярослав Эдуардович, ИУ5-36Б
#
# Все команды, введённые при выполнении пунктов задания.
# Имена с символами ! $ # @ и пробелами берём в одинарные кавычки:
# в двойных кавычках bash подставил бы $2 как переменную,
# а ! в интерактивном режиме — как ссылку на историю команд.

# 1. Папка Work, внутри две папки: «Лабораторная работа №1!» и «ФИО»
mkdir Work
cd Work
mkdir 'Лабораторная работа №1!'
mkdir 'Антропов Ярослав Эдуардович'

# 2. Права: на «Лабораторная работа №1!» владельцу и группе rwx, остальным только запись (7 7 2)
chmod 772 'Лабораторная работа №1!'
#    на «ФИО» владельцу только запись (2 0 0)
chmod 200 'Антропов Ярослав Эдуардович'
ls -ld 'Лабораторная работа №1!' 'Антропов Ярослав Эдуардович'

# 3. Три файла в папке Work
touch 'Text @1' 'Text $2' 'Text  #3'

# 4. Текст в «Text @1» без редактора (каждая фраза с новой строки)
echo 'Птица говорун отличается умом и сообразительностью!' > 'Text @1'
echo 'Отличается умом, отличается сообразительностью...' >> 'Text @1'

# 5. Копируем содержимое «Text @1» в «Text $2»
cat 'Text @1' > 'Text $2'

# 6. «Text $2» перемещаем в «Лабораторная работа №1!», «Text @1» копируем в «ФИО».
#    С правами 200 владелец не может положить файл в «ФИО»:
#    для этого нужно право x (вход в каталог), а для T* в п.11 — право r.
#    Поэтому на время работы возвращаем полные права, в конце снова ставим 200.
chmod 700 'Антропов Ярослав Эдуардович'
mv 'Text $2' 'Лабораторная работа №1!/'
cp 'Text @1' 'Антропов Ярослав Эдуардович/'

# 7. Сжимаем «Text @1» и «Text  #3» (-k — оставить исходные файлы,
#    они нужны в п.8 и п.9) и добавляем сжатые файлы в архив MyAchiv
gzip -k 'Text @1' 'Text  #3'
tar -cf MyAchiv.tar 'Text @1.gz' 'Text  #3.gz'
tar -tf MyAchiv.tar

# 8. Первая строка «Text @1» -> в «Text  #3», затем ещё одна строка в конец
head -n 1 'Text @1' >> 'Text  #3'
echo 'Будь осторожен! Преступник вооружен!' >> 'Text  #3'

# 9. В «ФИО» файл Result_one — содержимое «Text @1» в обратном порядке строк
tac 'Text @1' > 'Антропов Ярослав Эдуардович/Result_one'

# 10. Переименовываем Result_one в Result_two
mv 'Антропов Ярослав Эдуардович/Result_one' 'Антропов Ярослав Эдуардович/Result_two'

# 11. В «Лабораторная работа №1!» файл Result_3 — содержимое файлов «ФИО», начинающихся на T
cat 'Антропов Ярослав Эдуардович'/T* > 'Лабораторная работа №1!/Result_3'

# 12. Дописываем в конец Result_3 полную информацию о ядре и текущую дату
uname -a >> 'Лабораторная работа №1!/Result_3'
date >> 'Лабораторная работа №1!/Result_3'

# Возвращаем на «ФИО» права из п.2
chmod 200 'Антропов Ярослав Эдуардович'
ls -l
cd ..